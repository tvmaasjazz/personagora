{
  "permissions": {
    "deny": ["Bash(git push origin main*)", "Bash(git push * main)", "Bash(git push --force*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-commit.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
